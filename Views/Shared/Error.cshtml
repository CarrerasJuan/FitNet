@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title ?? "Incidencia del Sistema";
    
    var iconClass = Model.StatusCode switch
    {
        404 => "fa-compass text-warning",
        401 or 403 => "fa-shield-halved text-warning",
        409 => "fa-link-slash text-warning",
        503 => "fa-server text-danger",
        _ => "fa-triangle-exclamation text-danger"
    };

    var badgeClass = Model.StatusCode switch
    {
        >= 400 and < 500 => "bg-warning bg-opacity-25 text-warning border-warning",
        _ => "bg-danger bg-opacity-25 text-danger border-danger"
    };
}

<div class="py-5 text-center" style="min-height: 80vh; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at center, #261138 0%, #100817 75%);">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="p-5 rounded-4 border border-secondary border-opacity-25 bg-card-fn shadow-lg">
                    <div class="fs-1 mb-3">
                        <i class="fa-solid @iconClass fa-2x"></i>
                    </div>

                    <span class="hero-badge @badgeClass mb-3">
                        HTTP @Model.StatusCode &bull; RESILIENCIA FITNET
                    </span>

                    <h1 class="font-heading display-6 fw-bold text-white mt-2 mb-3 text-uppercase">
                        @(Model.Title ?? "Incidencia Técnica")
                    </h1>

                    <p class="text-muted leading-relaxed mb-4 fs-6">
                        @(Model.ErrorMessage ?? "Ocurrió un error inesperado al procesar la solicitud.")
                    </p>

                    @if (Model.ShowRequestId)
                    {
                        <div class="mb-4">
                            <span class="badge bg-dark border border-secondary border-opacity-25 text-muted font-monospace py-2 px-3">
                                <i class="fa-solid fa-fingerprint me-1 text-primary-fn"></i> ID de Rastreo: <code>@Model.RequestId</code>
                            </span>
                        </div>
                    }

                    <div class="d-flex flex-wrap justify-content-center gap-3 pt-2">
                        <a href="/" class="btn-fn-primary">
                            <i class="fa-solid fa-house me-1"></i> Volver al Inicio
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin") || User.IsInRole("Owner"))
                            {
                                <a asp-controller="Admin" asp-action="Dashboard" class="btn-fn-outline">
                                    <i class="fa-solid fa-gauge-high me-1"></i> Panel de Administración
                                </a>
                            }
                            else if (User.IsInRole("Trainer"))
                            {
                                <a asp-controller="Trainers" asp-action="Members" class="btn-fn-outline">
                                    <i class="fa-solid fa-clipboard-user me-1"></i> Panel del Entrenador
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Members" asp-action="Workouts" class="btn-fn-outline">
                                    <i class="fa-solid fa-dumbbell me-1"></i> Mis Rutinas
                                </a>
                            }
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn-fn-outline">
                                <i class="fa-solid fa-right-to-bracket me-1"></i> Iniciar Sesión
                            </a>
                        }

                        <button onclick="window.history.back()" class="btn btn-outline-secondary px-3 py-2 rounded-pill text-uppercase fs-7 fw-semibold">
                            <i class="fa-solid fa-arrow-left me-1"></i> Regresar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
