@model FitNet.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="py-5" style="min-height: 85vh; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at center, #231135 0%, #100817 70%);">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8 col-sm-11">
                <!-- Tarjeta Principal de Login -->
                <div class="p-4 p-md-5 rounded-3 border border-fn bg-card-fn shadow-lg">
                    <!-- Cabecera con Logo -->
                    <div class="text-center mb-4">
                        <img src="~/img/logo/logo-Fitnet-sinfondo.webp" 
                             alt="FitNet" 
                             height="64" 
                             class="mb-2"
                             onerror="this.onerror=null; this.src='/img/logo/logo-Fitnet-sinfondo.png';" />
                        <h2 class="font-heading fs-2 fw-bold text-white mb-1">INICIAR SESIÓN</h2>
                        <p class="text-muted small">Ingresá a tu cuenta para continuar</p>
                    </div>

                    <!-- Mensajes de Error de Validación -->
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger bg-danger bg-opacity-25 border-danger text-white py-2 small mb-3">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i>
                            <span asp-validation-summary="ModelOnly"></span>
                        </div>
                    }

                    <!-- Formulario de Acceso -->
                    <form asp-action="Login" asp-controller="Account" asp-route-returnurl="@Model.ReturnUrl" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label font-heading text-white small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary border-opacity-50 text-primary-fn">
                                    <i class="fa-solid fa-envelope"></i>
                                </span>
                                <input asp-for="Email" 
                                       id="txtEmail"
                                       class="form-control calculator-input" 
                                       placeholder="nombre@ejemplo.com" 
                                       autocomplete="username" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label font-heading text-white small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary border-opacity-50 text-primary-fn">
                                    <i class="fa-solid fa-lock"></i>
                                </span>
                                <input asp-for="Password" 
                                       id="txtPassword"
                                       type="password" 
                                       class="form-control calculator-input" 
                                       placeholder="••••••••" 
                                       autocomplete="current-password" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input bg-dark border-secondary" type="checkbox" id="chkRemember">
                                <label class="form-check-label text-muted small" for="chkRemember">
                                    Recordarme
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn-fn-primary w-100 py-2 fs-6">
                            <i class="fa-solid fa-right-to-bracket"></i> INGRESAR A FITNET
                        </button>
                    </form>

                    <!-- Enlace hacia Registro -->
                    <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                        <span class="text-muted small">¿Todavía no tenés cuenta?</span>
                        <a href="/Account/Register?plan=free" class="text-primary-fn fw-bold text-decoration-none small d-block mt-1 font-heading text-uppercase">
                            Comenzá tu prueba de 24 horas gratis <i class="fa-solid fa-arrow-right fa-xs"></i>
                        </a>
                    </div>
                </div>

                <!-- Tarjeta Auxiliar para Demostración / Cátedra (Autocompletar cuentas) -->
                <div class="p-3 mt-3 rounded-3 border border-secondary border-opacity-25 bg-surface-fn text-center">
                    <span class="text-primary-fn font-heading small fw-bold text-uppercase d-block mb-2">
                        <i class="fa-solid fa-flask-vial me-1"></i> Cuentas de Prueba para la Cátedra
                    </span>
                    <div class="d-flex flex-wrap gap-1 justify-content-center">
                        <button type="button" class="btn btn-outline-secondary btn-sm text-white px-2 py-1 small" onclick="fillCreds('owner@fitnet.com', 'Owner123!')">
                            👑 Owner
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm text-white px-2 py-1 small" onclick="fillCreds('admin@fitnet.com', 'Admin123!')">
                            ⚙️ Admin
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm text-white px-2 py-1 small" onclick="fillCreds('trainer@fitnet.com', 'Trainer123!')">
                            🏋️ Trainer
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm text-white px-2 py-1 small" onclick="fillCreds('member@fitnet.com', 'Member123!')">
                            ⭐ Member (Gold)
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm text-white px-2 py-1 small" onclick="fillCreds('trial@fitnet.com', 'Trial123!')">
                            ⏱️ Member (Trial 24h)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCreds(email, pass) {
            document.getElementById('txtEmail').value = email;
            document.getElementById('txtPassword').value = pass;
        }
    </script>
}
