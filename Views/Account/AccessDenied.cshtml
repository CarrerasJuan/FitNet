@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="py-5 text-center" style="min-height: 80vh; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at center, #261138 0%, #100817 75%);">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="p-5 rounded-3 border border-danger border-opacity-50 bg-card-fn shadow-lg">
                    <div class="text-danger fs-1 mb-3">
                        <i class="fa-solid fa-hand-sparkles fa-2x"></i>
                    </div>
                    <span class="hero-badge bg-danger bg-opacity-25 text-danger border-danger">SEGURIDAD FITNET</span>
                    <h2 class="font-heading display-6 fw-bold text-white mt-2 mb-3">ACCESO RESTRINGIDO</h2>
                    <p class="text-muted leading-relaxed mb-4">
                        Tu cuenta actual no posee los permisos de rol requeridos para ingresar a este módulo. Si considerás que se trata de un error, contactá a la administración del gimnasio.
                    </p>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="/" class="btn-fn-primary">
                            <i class="fa-solid fa-house"></i> Volver al Inicio
                        </a>
                        <a href="/Account/Profile" class="btn-fn-outline">
                            <i class="fa-solid fa-user"></i> Mi Perfil
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
