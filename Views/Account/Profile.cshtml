@model FitNet.ViewModels.Account.ProfileViewModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Mi Perfil de Usuario";
}

<!-- Page Header (Metis Pattern) -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="font-heading display-6 fw-bold text-white mb-1">MI PERFIL DE USUARIO</h1>
        <p class="text-muted small mb-0">Administrá tus datos personales, físicos y credenciales de acceso</p>
    </div>
    @if (Model.Role == "Member")
    {
        <a asp-controller="Members" asp-action="Dashboard" class="btn btn-outline-secondary text-white font-heading">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver a mi Dashboard
        </a>
    }
</div>

<!-- Notificaciones Flash TempData -->
@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success bg-success bg-opacity-25 border-success text-white alert-dismissible fade show mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2 text-primary-fn"></i>
        @TempData["MensajeExito"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger bg-danger bg-opacity-25 border-danger text-white alert-dismissible fade show mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>
        @TempData["MensajeError"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
            <!-- Columna Izquierda: Tarjeta Resumen de Usuario -->
            <div class="col-lg-4">
                <div class="p-4 rounded-3 border border-fn bg-card-fn text-center mb-4">
                    <!-- Avatar Circular -->
                    <div class="position-relative d-inline-block mb-3">
                        @if (!string.IsNullOrEmpty(Model.AvatarPath))
                        {
                            <img src="@Model.AvatarPath" alt="Avatar" class="rounded-circle border border-primary border-3" style="width: 110px; height: 110px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-surface-fn border border-fn d-flex align-items-center justify-content-center text-primary-fn" style="width: 110px; height: 110px; font-size: 3rem;">
                                <i class="fa-solid fa-user"></i>
                            </div>
                        }
                    </div>

                    <h3 class="font-heading fs-4 fw-bold text-white mb-1">@Model.FirstName @Model.LastName</h3>
                    <p class="text-muted small mb-2">@Model.Email</p>

                    <!-- Badges de Rol y Membresía -->
                    <div class="d-flex justify-content-center gap-2 mb-3">
                        <span class="badge bg-primary-fn text-uppercase font-heading">
                            <i class="fa-solid fa-shield me-1"></i> @Model.Role
                        </span>

                        @if (Model.Role == "Member")
                        {
                            <span class="badge @(Model.PlanName == "Gold" ? "bg-warning text-dark" : Model.PlanName == "Premium" ? "bg-info text-dark" : "bg-secondary") font-heading text-uppercase">
                                <i class="fa-solid fa-tag me-1"></i> Plan @Model.PlanName
                            </span>
                        }
                    </div>

                    <!-- Si es Socio Free con Trial Activo -->
                    @if (Model.Role == "Member" && Model.PlanName == "Free")
                    {
                        <div class="p-3 bg-surface-fn border border-warning border-opacity-50 rounded text-start mb-3">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="fa-solid fa-stopwatch text-warning"></i>
                                <span class="font-heading small fw-bold text-warning text-uppercase">Trial de 24 Horas</span>
                            </div>
                            @if (Model.IsTrialActive)
                            {
                                <p class="text-muted small mb-2">
                                    Te quedan aproximadamente <strong class="text-white">@Model.TrialHoursRemaining horas</strong> de prueba gratuita.
                                </p>
                            }
                            else
                            {
                                <p class="text-danger small mb-2">
                                    Tu período de prueba de 24 horas ha expirado.
                                </p>
                            }
                            <a href="/Billing/Checkout?plan=gold" class="btn btn-sm btn-fn-primary w-100 font-heading">
                                <i class="fa-solid fa-crown me-1"></i> Mejorar a Plan Gold
                            </a>
                        </div>
                    }

                    <!-- Datos Profesionales si es Entrenador -->
                    @if (Model.Role == "Trainer" && !string.IsNullOrEmpty(Model.Specialty))
                    {
                        <div class="p-3 bg-surface-fn border border-fn rounded text-start mb-3">
                            <span class="font-heading small fw-bold text-primary-fn text-uppercase d-block mb-1">Especialidad</span>
                            <div class="text-white small fw-bold mb-2">@Model.Specialty</div>
                            @if (!string.IsNullOrEmpty(Model.Biography))
                            {
                                <span class="font-heading small fw-bold text-muted text-uppercase d-block mb-1">Biografía</span>
                                <p class="text-muted small mb-0">@Model.Biography</p>
                            }
                        </div>
                    }

                    <form asp-action="Logout" asp-controller="Account" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                            <i class="fa-solid fa-right-from-bracket me-1"></i> Cerrar Sesión
                        </button>
                    </form>
                </div>
            </div>

            <!-- Columna Derecha: Edición de Datos y Cambio de Contraseña -->
            <div class="col-lg-8">
                <!-- Tarjeta 1: Datos Personales -->
                <div class="p-4 p-md-5 rounded-3 border border-fn bg-card-fn mb-4">
                    <div class="d-flex align-items-center gap-2 mb-4 pb-2 border-bottom border-secondary border-opacity-25">
                        <i class="fa-solid fa-user-pen fa-lg text-primary-fn"></i>
                        <h4 class="font-heading fs-4 fw-bold text-white mb-0">DATOS PERSONALES</h4>
                    </div>

                    <form asp-action="Profile" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Email" />

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label font-heading text-white small"></label>
                                <input asp-for="FirstName" class="form-control calculator-input" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label font-heading text-white small"></label>
                                <input asp-for="LastName" class="form-control calculator-input" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label font-heading text-white small"></label>
                                <input asp-for="Email" class="form-control calculator-input opacity-75" disabled />
                                <small class="text-muted">El correo electrónico no puede modificarse.</small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label font-heading text-white small"></label>
                                <input asp-for="PhoneNumber" class="form-control calculator-input" placeholder="Ej: +54 266 400-0000" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        @if (Model.Role == "Member")
                        {
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label asp-for="Height" class="form-label font-heading text-white small"></label>
                                    <input asp-for="Height" type="number" class="form-control calculator-input" placeholder="Ej: 178" min="100" max="250" />
                                    <span asp-validation-for="Height" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="BirthDate" class="form-label font-heading text-white small"></label>
                                    <input asp-for="BirthDate" type="date" class="form-control calculator-input" />
                                    <span asp-validation-for="BirthDate" class="text-danger small"></span>
                                </div>
                            </div>
                        }

                        <button type="submit" class="btn-fn-primary py-2 px-4">
                            <i class="fa-solid fa-floppy-disk"></i> Guardar Cambios
                        </button>
                    </form>
                </div>

                <!-- Tarjeta 2: Cambio de Contraseña -->
                <div class="p-4 p-md-5 rounded-3 border border-fn bg-card-fn">
                    <div class="d-flex align-items-center gap-2 mb-4 pb-2 border-bottom border-secondary border-opacity-25">
                        <i class="fa-solid fa-key fa-lg text-primary-fn"></i>
                        <h4 class="font-heading fs-4 fw-bold text-white mb-0">SEGURIDAD Y CONTRASEÑA</h4>
                    </div>

                    <form asp-action="ChangePassword" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="txtCurrentPassword" class="form-label font-heading text-white small">Contraseña Actual</label>
                            <input name="CurrentPassword" id="txtCurrentPassword" type="password" class="form-control calculator-input" required />
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label for="txtNewPassword" class="form-label font-heading text-white small">Nueva Contraseña</label>
                                <input name="NewPassword" id="txtNewPassword" type="password" class="form-control calculator-input" minlength="6" required />
                            </div>
                            <div class="col-md-6">
                                <label for="txtConfirmNewPassword" class="form-label font-heading text-white small">Confirmar Nueva Contraseña</label>
                                <input name="ConfirmNewPassword" id="txtConfirmNewPassword" type="password" class="form-control calculator-input" minlength="6" required />
                            </div>
                        </div>

                        <button type="submit" class="btn-fn-outline py-2 px-4">
                            <i class="fa-solid fa-lock"></i> Actualizar Contraseña
                        </button>
                    </form>
                </div>
            </div>
        </div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
