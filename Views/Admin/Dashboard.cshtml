@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Panel de Control Administrativo";
    var recentMembers = ViewBag.RecentMembers as List<FitNet.Models.MemberProfile> ?? new List<FitNet.Models.MemberProfile>();
}

<!-- Encabezado de Página (Metis Pattern) -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="font-heading display-6 fw-bold text-white mb-1">DASHBOARD DE ADMINISTRACIÓN</h1>
        <p class="text-muted small mb-0">Gestión global del gimnasio, estado de socios y operaciones</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Admin" asp-action="Members" class="btn btn-fn-primary font-heading px-3 py-2">
            <i class="fa-solid fa-users me-1"></i> Gestionar Socios
        </a>
    </div>
</div>

<!-- ==========================================
     FILA DE TARJETAS KPI (Metis Stats Cards)
     ========================================== -->
<div class="row g-3 g-lg-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stats-card">
            <div class="stats-icon stats-icon-lime">
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="stats-content">
                <div class="stats-label">Total Socios</div>
                <div class="stats-value">@ViewBag.TotalMembers</div>
                <div class="stats-sub text-primary-fn"><i class="fa-solid fa-check me-1"></i>Registrados en base</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stats-card">
            <div class="stats-icon stats-icon-purple">
                <i class="fa-solid fa-crown"></i>
            </div>
            <div class="stats-content">
                <div class="stats-label">Socios Gold</div>
                <div class="stats-value">@ViewBag.GoldMembers</div>
                <div class="stats-sub text-muted">Abono regular ($32.000)</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stats-card">
            <div class="stats-icon stats-icon-blue">
                <i class="fa-solid fa-gem"></i>
            </div>
            <div class="stats-content">
                <div class="stats-label">Socios Premium</div>
                <div class="stats-value">@ViewBag.PremiumMembers</div>
                <div class="stats-sub text-info">Con coach asignado</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stats-card">
            <div class="stats-icon stats-icon-orange">
                <i class="fa-solid fa-user-clock"></i>
            </div>
            <div class="stats-content">
                <div class="stats-label">En Trial 24h</div>
                <div class="stats-value">@ViewBag.FreeMembers</div>
                <div class="stats-sub text-warning">Potenciales upgrades</div>
            </div>
        </div>
    </div>
</div>

<!-- Grilla de Tablas y Actividad Reciente -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="fn-card">
            <div class="fn-card-header">
                <div class="fn-card-title">
                    <i class="fa-solid fa-user-plus text-primary-fn"></i>
                    <span>Últimos Socios Registrados</span>
                </div>
                <a asp-controller="Admin" asp-action="Members" class="text-primary-fn small text-decoration-none font-heading">
                    Ver todos <i class="fa-solid fa-arrow-right fa-xs"></i>
                </a>
            </div>
            <div class="fn-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0" style="background: transparent;">
                        <thead>
                            <tr class="border-bottom border-secondary border-opacity-25 text-muted small font-heading">
                                <th class="ps-4">Socio</th>
                                <th>Email</th>
                                <th>Plan Actual</th>
                                <th>Fecha Alta</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in recentMembers)
                            {
                                <tr>
                                    <td class="ps-4 text-white fw-bold">
                                        <i class="fa-solid fa-circle-user text-primary-fn me-2"></i>
                                        @m.User.FirstName @m.User.LastName
                                    </td>
                                    <td class="text-muted small">@m.User.Email</td>
                                    <td>
                                        <span class="badge @(m.Membership.Name == "Gold" ? "bg-warning text-dark" : m.Membership.Name == "Premium" ? "bg-info text-dark" : "bg-secondary") font-heading text-uppercase">
                                            @m.Membership.Name
                                        </span>
                                    </td>
                                    <td class="text-muted small">@m.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="fn-card">
            <div class="fn-card-header">
                <div class="fn-card-title">
                    <i class="fa-solid fa-bolt text-primary-fn"></i>
                    <span>Accesos Rápidos</span>
                </div>
            </div>
            <div class="fn-card-body d-flex flex-column gap-2">
                <a asp-controller="Admin" asp-action="Members" class="btn btn-dark text-start border border-secondary border-opacity-25 py-2 px-3 d-flex align-items-center justify-content-between">
                    <span><i class="fa-solid fa-users text-primary-fn me-2"></i> Directorio de Socios</span>
                    <i class="fa-solid fa-chevron-right fa-xs text-muted"></i>
                </a>
                <a asp-controller="Admin" asp-action="Trainers" class="btn btn-dark text-start border border-secondary border-opacity-25 py-2 px-3 d-flex align-items-center justify-content-between">
                    <span><i class="fa-solid fa-user-tie text-info me-2"></i> Staff de Entrenadores</span>
                    <i class="fa-solid fa-chevron-right fa-xs text-muted"></i>
                </a>
                <a asp-controller="Exercises" asp-action="Index" class="btn btn-dark text-start border border-secondary border-opacity-25 py-2 px-3 d-flex align-items-center justify-content-between">
                    <span><i class="fa-solid fa-dumbbell text-warning me-2"></i> Catálogo de Ejercicios</span>
                    <i class="fa-solid fa-chevron-right fa-xs text-muted"></i>
                </a>
            </div>
        </div>
    </div>
</div>
