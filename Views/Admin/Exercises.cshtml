@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Gestión de Ejercicios";
}

<!-- Page Header (Metis UI) -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary-fn text-uppercase font-heading">
                <i class="fa-solid fa-dumbbell me-1"></i> Administración
            </span>
            <span class="badge bg-secondary font-heading text-uppercase">Catálogo</span>
        </div>
        <h1 class="font-heading display-6 fw-bold text-white mb-1">STOCK Y CATÁLOGO DE EJERCICIOS</h1>
        <p class="text-muted small mb-0">Gestión técnica de movimientos, grupos musculares y fotos para la prescripción de rutinas.</p>
    </div>

    @if (User.IsInRole("Trainer") && !User.IsInRole("Admin") && !User.IsInRole("Owner"))
    {
        <a asp-controller="Trainers" asp-action="Dashboard" class="btn btn-outline-secondary text-white font-heading btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver a Panel Coach
        </a>
    }
    else
    {
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary text-white font-heading btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver al Panel Admin
        </a>
    }
</div>

<!-- ==========================================================================
     Contenedor Raíz donde Fede montará la aplicación Vue 3 (Tarea 8.4)
     ========================================================================== -->
<div id="app-ejercicios">
    <div class="fn-card">
        <div class="fn-card-header d-flex justify-content-between align-items-center">
            <div class="fn-card-title">
                <i class="fa-solid fa-list-check text-primary-fn"></i>
                <span>Directorio de Movimientos Técnicos</span>
            </div>
        </div>
        <div class="fn-card-body text-center py-5">
            <div class="spinner-border text-primary-fn mb-3" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <div class="text-muted small font-heading">
                Inicializando módulo interactivo de ejercicios...
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Inyección local de Vue 3 y Axios (100% Offline, sin Node ni CDNs) -->
    <script src="~/lib/vue/vue.global.prod.js"></script>
    <script src="~/lib/axios/axios.min.js"></script>
    
    <!-- Script de la aplicación Vue 3 (Tarea 8.4 - Fede) -->
    <script src="~/js/vue-apps/ejercicios/app.js" asp-append-version="true"></script>
}
