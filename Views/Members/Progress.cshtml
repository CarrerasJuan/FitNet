@model FitNet.ViewModels.Members.MemberProgressViewModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Mi Progreso y Evolución Física";
}

<!-- Page Header (Metis UI) -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary-fn text-uppercase font-heading">
                <i class="fa-solid fa-chart-line me-1"></i> Biometría & Antropometría
            </span>
            <span class="badge bg-secondary font-heading text-uppercase">Plan @Model.PlanName</span>
        </div>
        <h1 class="font-heading display-6 fw-bold text-white mb-1">MI PROGRESO Y EVOLUCIÓN FÍSICA</h1>
        <p class="text-muted small mb-0">Registrá tus pesajes periódicos, porcentaje de grasa y fotos de transformación.</p>
    </div>

    <a asp-controller="Members" asp-action="Dashboard" class="btn btn-outline-secondary text-white font-heading btn-sm">
        <i class="fa-solid fa-arrow-left me-1"></i> Volver a mi Dashboard
    </a>
</div>

<!-- Flash Notifications TempData -->
@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success bg-success bg-opacity-25 border-success text-white alert-dismissible fade show mb-4 small" role="alert">
        <i class="fa-solid fa-circle-check me-2 text-primary-fn"></i>
        @TempData["MensajeExito"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger bg-danger bg-opacity-25 border-danger text-white alert-dismissible fade show mb-4 small" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>
        @TempData["MensajeError"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- ==========================================
     MÉTRICAS RESUMEN (KPI CARDS)
     ========================================== -->
<div class="row g-3 mb-4">
    <!-- Card 1: Último Peso -->
    <div class="col-sm-6 col-lg-3">
        <div class="p-3 rounded-3 border border-fn bg-card-fn h-100">
            <span class="text-muted small font-heading text-uppercase d-block mb-1">Último Peso Registrado</span>
            <div class="d-flex align-items-baseline gap-2">
                <span class="font-heading fs-3 fw-bold text-white">
                    @(Model.LatestWeight.HasValue ? $"{Model.LatestWeight.Value:F1} kg" : "—")
                </span>
            </div>
            <small class="text-white-50" style="font-size: 0.75rem;">
                <i class="fa-solid fa-weight-scale text-primary-fn me-1"></i> En báscula
            </small>
        </div>
    </div>

    <!-- Card 2: Variación de Peso -->
    <div class="col-sm-6 col-lg-3">
        <div class="p-3 rounded-3 border border-fn bg-card-fn h-100">
            <span class="text-muted small font-heading text-uppercase d-block mb-1">Variación Acumulada</span>
            <div class="d-flex align-items-baseline gap-2">
                @if (Model.WeightDifference.HasValue)
                {
                    var isDiffNeg = Model.WeightDifference.Value < 0;
                    <span class="font-heading fs-3 fw-bold @(isDiffNeg ? "text-success" : "text-info")">
                        @(Model.WeightDifference.Value > 0 ? "+" : "")@Model.WeightDifference.Value.ToString("F1") kg
                    </span>
                }
                else
                {
                    <span class="font-heading fs-3 fw-bold text-white">—</span>
                }
            </div>
            <small class="text-white-50" style="font-size: 0.75rem;">
                <i class="fa-solid fa-arrow-trend-up text-primary-fn me-1"></i> Respecto al inicio
            </small>
        </div>
    </div>

    <!-- Card 3: Grasa Corporal -->
    <div class="col-sm-6 col-lg-3">
        <div class="p-3 rounded-3 border border-fn bg-card-fn h-100">
            <span class="text-muted small font-heading text-uppercase d-block mb-1">Grasa Corporal Actual</span>
            <div class="d-flex align-items-baseline gap-2">
                <span class="font-heading fs-3 fw-bold text-white">
                    @(Model.LatestBodyFat.HasValue ? $"{Model.LatestBodyFat.Value:F1} %" : "—")
                </span>
            </div>
            <small class="text-white-50" style="font-size: 0.75rem;">
                <i class="fa-solid fa-percent text-primary-fn me-1"></i> Composición física
            </small>
        </div>
    </div>

    <!-- Card 4: Total de Chequeos -->
    <div class="col-sm-6 col-lg-3">
        <div class="p-3 rounded-3 border border-fn bg-card-fn h-100">
            <span class="text-muted small font-heading text-uppercase d-block mb-1">Chequeos Realizados</span>
            <div class="d-flex align-items-baseline gap-2">
                <span class="font-heading fs-3 fw-bold text-white">@Model.TotalCheckins</span>
            </div>
            <small class="text-white-50" style="font-size: 0.75rem;">
                <i class="fa-solid fa-clipboard-check text-primary-fn me-1"></i> Registros en historial
            </small>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- Columna Izquierda: Formulario de Nuevo Registro -->
    <div class="col-lg-5">
        <div class="p-4 rounded-3 border border-fn bg-card-fn h-100">
            <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                <i class="fa-solid fa-plus-circle text-primary-fn fa-lg"></i>
                <h4 class="font-heading fs-5 fw-bold text-white mb-0">NUEVO CHEQUEO CORPORAL</h4>
            </div>

            <form asp-action="AddProgress" asp-controller="Members" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <!-- Fecha -->
                <div class="mb-3">
                    <label asp-for="Date" class="form-label font-heading text-white small fw-bold mb-1"></label>
                    <input asp-for="Date" type="date" class="form-control calculator-input" />
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <!-- Peso (kg) -->
                    <div class="col-6">
                        <label asp-for="Weight" class="form-label font-heading text-white small fw-bold mb-1"></label>
                        <input asp-for="Weight" type="number" step="0.1" class="form-control calculator-input" placeholder="Ej: 78.5" />
                        <span asp-validation-for="Weight" class="text-danger small"></span>
                    </div>

                    <!-- Grasa (%) -->
                    <div class="col-6">
                        <label asp-for="BodyFat" class="form-label font-heading text-white small fw-bold mb-1"></label>
                        <input asp-for="BodyFat" type="number" step="0.1" class="form-control calculator-input" placeholder="Ej: 15.2" />
                        <span asp-validation-for="BodyFat" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Foto de Progreso con Previsualización -->
                <div class="p-3 mb-3 rounded border border-secondary border-opacity-50 bg-surface-fn">
                    <label asp-for="ProgressPhoto" class="form-label font-heading text-white small fw-bold mb-1">
                        <i class="fa-solid fa-camera text-primary-fn me-1"></i> Foto de Evolución Corporal
                    </label>
                    <input asp-for="ProgressPhoto" id="photoInput" type="file" class="form-control calculator-input" accept=".jpg,.jpeg,.png,.webp" />
                    <span asp-validation-for="ProgressPhoto" class="text-danger small d-block mt-1"></span>
                    <small class="text-white-50 d-block mt-1" style="font-size: 0.75rem;">
                        Formatos permitidos: JPG, PNG, WEBP (máx. 2MB).
                    </small>

                    <div id="photoPreviewContainer" class="mt-2 d-none text-center">
                        <img id="photoPreview" src="#" alt="Previsualización" class="rounded border border-primary" style="max-height: 120px; object-fit: cover;" />
                    </div>
                </div>

                <!-- Notas -->
                <div class="mb-4">
                    <label asp-for="Notes" class="form-label font-heading text-white small fw-bold mb-1"></label>
                    <textarea asp-for="Notes" class="form-control calculator-input" rows="3" placeholder="Ej: Buena congestión, energía alta en sentadillas, dieta cumplida al 100%..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-fn-primary w-100 py-2">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Guardar Chequeo
                </button>
            </form>
        </div>
    </div>

    <!-- Columna Derecha: Historial Cronológico de Registros -->
    <div class="col-lg-7">
        <div class="p-4 rounded-3 border border-fn bg-card-fn h-100">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-clock-rotate-left text-primary-fn fa-lg"></i>
                    <h4 class="font-heading fs-5 fw-bold text-white mb-0">HISTORIAL DE PESAJES</h4>
                </div>
                <span class="text-muted small">@Model.Records.Count registros</span>
            </div>

            @if (Model.Records.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover border border-secondary border-opacity-25 rounded overflow-hidden align-middle mb-0">
                        <thead class="bg-surface-fn font-heading text-primary-fn small text-uppercase">
                            <tr>
                                <th class="ps-3">Fecha</th>
                                <th class="text-center">Peso</th>
                                <th class="text-center">Grasa</th>
                                <th>Notas</th>
                                <th class="text-center" style="width: 70px;">Foto</th>
                                <th class="text-end pe-3" style="width: 60px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Records)
                            {
                                <tr>
                                    <td class="ps-3 text-white fw-bold small">
                                        @r.Date.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-center font-heading fs-6 text-white">
                                        @(r.Weight.HasValue ? $"{r.Weight.Value:F1} kg" : "—")
                                    </td>
                                    <td class="text-center text-muted small">
                                        @(r.BodyFat.HasValue ? $"{r.BodyFat.Value:F1}%" : "—")
                                    </td>
                                    <td class="text-muted small" style="max-width: 180px;">
                                        <span class="d-inline-block text-truncate w-100">
                                            @(string.IsNullOrEmpty(r.Notes) ? "—" : r.Notes)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(r.ImagePath))
                                        {
                                            <a href="@r.ImagePath" target="_blank" title="Ver foto en tamaño completo">
                                                <img src="@r.ImagePath" alt="Foto" class="rounded border border-primary" style="width: 32px; height: 32px; object-fit: cover;" />
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <form asp-action="DeleteProgress" asp-controller="Members" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este registro de progreso?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm p-1" title="Eliminar registro">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted small">
                    <i class="fa-solid fa-scale-balanced fa-2x mb-2 d-block text-muted"></i>
                    Aún no registraste pesajes. Utilizá el formulario de la izquierda para registrar tu primer chequeo corporal.
                </div>
            }
        </div>
    </div>
</div>

<!-- ==========================================
     SECCIÓN 3: GALERÍA DE TRANSFORMACIÓN FÍSICA
     ========================================== -->
@if (Model.Records.Any(r => !string.IsNullOrEmpty(r.ImagePath)))
{
    <div class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-1">
            <i class="fa-solid fa-images text-primary-fn"></i>
            <h3 class="font-heading fs-4 fw-bold text-white mb-0">GALERÍA DE EVOLUCIÓN FÍSICA</h3>
        </div>
        <p class="text-muted small mb-3">Tus fotografías corporales ordenadas cronológicamente para comparar resultados.</p>

        <div class="row g-3">
            @foreach (var photoRecord in Model.Records.Where(r => !string.IsNullOrEmpty(r.ImagePath)))
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="rounded-3 border border-fn bg-card-fn overflow-hidden h-100">
                        <a href="@photoRecord.ImagePath" target="_blank">
                            <img src="@photoRecord.ImagePath" alt="Evolución" class="w-100" style="height: 200px; object-fit: cover;" />
                        </a>
                        <div class="p-2 text-center bg-surface-fn border-top border-secondary border-opacity-25">
                            <span class="font-heading text-white fw-bold d-block small">@photoRecord.Date.ToString("dd/MM/yyyy")</span>
                            <span class="badge bg-primary-fn font-heading" style="font-size: 0.72rem;">
                                @(photoRecord.Weight.HasValue ? $"{photoRecord.Weight.Value:F1} kg" : "Chequeo")
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const input = document.getElementById('photoInput');
            const preview = document.getElementById('photoPreview');
            const container = document.getElementById('photoPreviewContainer');

            if (input && preview && container) {
                input.addEventListener('change', function (e) {
                    const file = e.target.files && e.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (evt) {
                            preview.src = evt.target.result;
                            container.classList.remove('d-none');
                        };
                        reader.readAsDataURL(file);
                    } else {
                        container.classList.add('d-none');
                    }
                });
            }
        });
    </script>
}
