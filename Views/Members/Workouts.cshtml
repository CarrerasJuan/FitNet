@model FitNet.ViewModels.Members.MemberWorkoutsViewModel
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Mis Rutinas de Entrenamiento";
}

<!-- Page Header (Metis UI) -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge @(Model.IsPremium ? "bg-info text-dark" : "bg-warning text-dark") text-uppercase font-heading">
                <i class="fa-solid fa-crown me-1"></i> Plan @Model.PlanName Activo
            </span>
            <span class="badge bg-secondary font-heading text-uppercase">
                <i class="fa-solid fa-calendar-day me-1"></i> @Model.RemainingDays días restantes
            </span>
        </div>
        <h1 class="font-heading display-6 fw-bold text-white mb-1">MIS RUTINAS DE ENTRENAMIENTO</h1>
        <p class="text-muted small mb-0">Planes estructurados, series, repeticiones y recomendaciones de descanso.</p>
    </div>

    <div class="d-flex gap-2">
        <button type="button" onclick="window.print()" class="btn btn-outline-secondary text-white font-heading btn-sm">
            <i class="fa-solid fa-print me-1"></i> Imprimir Ficha
        </button>
        <a asp-controller="Members" asp-action="Dashboard" class="btn btn-outline-secondary text-white font-heading btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver a mi Dashboard
        </a>
    </div>
</div>

<!-- ==========================================
     SECCIÓN 1: RUTINA PERSONALIZADA ASIGNADA (COACH)
     ========================================== -->
@if (Model.ActiveAssignments.Any())
{
    @if (Model.ActiveAssignments.Count > 1)
    {
        <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-2 mb-4">
            <span class="text-muted small font-heading text-uppercase">
                <i class="fa-solid fa-calendar-week text-primary-fn me-1"></i> Planificación Semanal:
            </span>
            <div class="d-inline-flex p-1 rounded-pill bg-dark border border-secondary border-opacity-50 gap-1 flex-wrap shadow-sm">
                @for (int i = 0; i < Model.ActiveAssignments.Count; i++)
                {
                    var a = Model.ActiveAssignments[i];
                    <button type="button" 
                            class="btn btn-sm rounded-pill font-heading px-3 py-1 routine-split-tab @(i == 0 ? "btn-fn-primary text-dark fw-bold shadow-sm" : "text-white-50 border-0")"
                            onclick="showRoutineTab(@i)">
                        <i class="fa-solid fa-dumbbell me-1"></i> @a.WorkoutPlan.Name.ToUpper()
                    </button>
                }
            </div>
        </div>
    }

    @for (int i = 0; i < Model.ActiveAssignments.Count; i++)
    {
        var assignment = Model.ActiveAssignments[i];
        <div id="routine-card-@i" class="routine-card-container p-4 p-md-5 rounded-3 border border-fn bg-card-fn mb-5 position-relative shadow-sm" style="@(i > 0 ? "display: none;" : "")">
            <!-- Badge de Rutina Activa -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-primary-fn text-uppercase font-heading">Rutina Activa Personalizada</span>
                        <span class="text-muted small">Asignada el @assignment.StartDate.ToString("dd/MM/yyyy")</span>
                        @if (assignment.EndDate.HasValue)
                        {
                            <span class="badge bg-dark border border-secondary text-warning font-monospace small">
                                <i class="fa-solid fa-hourglass-half me-1"></i>Válida hasta @assignment.EndDate.Value.ToString("dd/MM/yyyy")
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-dark border border-secondary text-primary-fn font-monospace small">
                                <i class="fa-solid fa-infinity me-1"></i>Vigente continua
                            </span>
                        }
                    </div>
                    <h2 class="font-heading fs-3 fw-bold text-white mb-0">@assignment.WorkoutPlan.Name.ToUpper()</h2>
                </div>

                @if (assignment.AssignedByTrainer != null)
                {
                    <div class="d-flex align-items-center gap-2 p-2 rounded bg-surface-fn border border-fn">
                        @if (!string.IsNullOrEmpty(assignment.AssignedByTrainer.AvatarPath))
                        {
                            <img src="@assignment.AssignedByTrainer.AvatarPath" alt="Coach" class="rounded-circle border border-primary" style="width: 36px; height: 36px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-surface-fn border border-fn d-flex align-items-center justify-content-center text-primary-fn" style="width: 36px; height: 36px;">
                                <i class="fa-solid fa-user-ninja"></i>
                            </div>
                        }
                        <div>
                            <span class="text-muted d-block" style="font-size: 0.72rem;">COACH ASIGNADO</span>
                            <span class="text-white font-heading fw-bold" style="font-size: 0.85rem;">
                                @assignment.AssignedByTrainer.FirstName @assignment.AssignedByTrainer.LastName
                            </span>
                        </div>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(assignment.WorkoutPlan.Description))
            {
                <p class="text-muted small mb-4" style="line-height: 1.6;">
                    <i class="fa-solid fa-quote-left text-primary-fn me-1"></i> @assignment.WorkoutPlan.Description
                </p>
            }

            <!-- Tabla de Ejercicios del Plan -->
            <div class="table-responsive">
                <table class="table table-dark table-hover border border-secondary border-opacity-25 rounded overflow-hidden align-middle mb-0">
                    <thead class="bg-surface-fn font-heading text-primary-fn small text-uppercase">
                        <tr>
                            <th class="ps-3" style="width: 60px;">#</th>
                            <th>Ejercicio</th>
                            <th>Grupo</th>
                            <th class="text-center" style="width: 110px;">Series</th>
                            <th class="text-center" style="width: 120px;">Reps</th>
                            <th class="text-center" style="width: 120px;">Descanso</th>
                            <th>Notas del Coach</th>
                            <th class="text-end pe-3" style="width: 100px;">Guía</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (assignment.WorkoutPlan.WorkoutExercises.Any())
                        {
                            @foreach (var we in assignment.WorkoutPlan.WorkoutExercises)
                            {
                                <tr>
                                    <td class="ps-3 font-heading text-primary-fn fw-bold">@we.Order</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(we.Exercise.ImagePath))
                                            {
                                                <img src="@we.Exercise.ImagePath" alt="@we.Exercise.Name" 
                                                     class="rounded border border-secondary border-opacity-50" 
                                                     style="width: 38px; height: 38px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded bg-black bg-opacity-50 border border-secondary border-opacity-50 d-flex align-items-center justify-content-center text-muted" 
                                                     style="width: 38px; height: 38px;">
                                                    <i class="fa-solid fa-dumbbell"></i>
                                                </div>
                                            }
                                            <div>
                                                <span class="text-white fw-bold d-block">@we.Exercise.Name</span>
                                                <span class="badge bg-secondary font-heading" style="font-size: 0.65rem;">@we.Exercise.Difficulty</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-surface-fn border border-fn text-white-50 font-heading">
                                            @we.Exercise.MuscleGroup
                                        </span>
                                    </td>
                                    <td class="text-center font-heading">
                                        <span class="text-white fw-bold fs-6">@we.Sets</span>
                                        <small class="text-white-50 d-block" style="font-size: 0.68rem;">SERIES</small>
                                    </td>
                                    <td class="text-center font-heading">
                                        <span class="text-primary-fn fw-bold fs-6">@we.Repetitions</span>
                                        <small class="text-white-50 d-block" style="font-size: 0.68rem;">REPS</small>
                                    </td>
                                    <td class="text-center font-heading">
                                        <span class="text-warning small"><i class="fa-solid fa-stopwatch me-1"></i>@we.RestSeconds seg</span>
                                        <small class="text-white-50 d-block" style="font-size: 0.68rem;">DESCANSO</small>
                                    </td>
                                    <td class="text-muted small">
                                        @(string.IsNullOrEmpty(we.Notes) ? "—" : we.Notes)
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="d-flex justify-content-end gap-1">
                                            <button type="button" class="btn btn-fn-primary btn-sm py-1 px-2 font-heading" 
                                                    data-bs-toggle="modal" data-bs-target="#modalDemo-@assignment.Id-@we.ExerciseId" 
                                                    title="Ver animación técnica y cronómetro">
                                                <i class="fa-solid fa-play me-1"></i> Demo
                                            </button>
                                            <a asp-controller="Exercises" asp-action="Details" asp-route-id="@we.ExerciseId" 
                                               class="btn btn-outline-light btn-sm py-1 px-2 font-heading" title="Ver ficha técnica completa">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted small">
                                    Esta rutina aún no tiene ejercicios asignados por el entrenador.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Modales de Demostración Técnica en Vivo y Temporizador para cada Ejercicio -->
        @foreach (var we in assignment.WorkoutPlan.WorkoutExercises)
        {
            <div class="modal fade" id="modalDemo-@assignment.Id-@we.ExerciseId" tabindex="-1" aria-labelledby="modalDemoLabel-@assignment.Id-@we.ExerciseId" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content bg-card-fn border border-fn text-white shadow-lg">
                        <div class="modal-header border-secondary border-opacity-25 pb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary-fn text-dark font-heading text-uppercase">#@we.Order</span>
                                <span class="badge bg-secondary font-heading text-uppercase">@we.Exercise.MuscleGroup</span>
                                <h5 class="modal-title font-heading fw-bold text-white mb-0" id="modalDemoLabel-@assignment.Id-@we.ExerciseId">
                                    @we.Exercise.Name.ToUpper()
                                </h5>
                            </div>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="row g-4 align-items-center">
                                <!-- Columna Izquierda: Animación GIF en bucle -->
                                <div class="col-md-6 text-center">
                                    @if (!string.IsNullOrEmpty(we.Exercise.ImagePath))
                                    {
                                        <div class="position-relative d-inline-block rounded-3 overflow-hidden border border-fn shadow">
                                            <img src="@we.Exercise.ImagePath" alt="@we.Exercise.Name" 
                                                 class="img-fluid" style="max-height: 280px; width: auto; object-fit: contain; background: #000;" />
                                            <span class="position-absolute bottom-0 start-0 m-2 badge bg-dark bg-opacity-75 text-primary-fn font-monospace small">
                                                <i class="fa-solid fa-circle text-danger fa-fade me-1"></i> EN VIVO (LOOP)
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rounded-3 bg-dark border border-secondary p-5 text-muted">
                                            <i class="fa-solid fa-dumbbell fa-3x mb-2 text-primary-fn"></i>
                                            <div>Sin animación disponible</div>
                                        </div>
                                    }
                                </div>

                                <!-- Columna Derecha: Prescripción del Coach + Temporizador -->
                                <div class="col-md-6">
                                    <!-- Metas de Carga del Coach -->
                                    <div class="p-3 rounded-3 bg-surface-fn border border-secondary border-opacity-50 mb-3">
                                        <div class="font-heading small text-muted text-uppercase mb-2">Prescripción del Entrenador</div>
                                        <div class="d-flex justify-content-around text-center">
                                            <div>
                                                <div class="font-heading fw-bold fs-4 text-white">@we.Sets</div>
                                                <div class="text-white-50 small" style="font-size: 0.7rem;">SERIES</div>
                                            </div>
                                            <div class="border-start border-secondary border-opacity-25"></div>
                                            <div>
                                                <div class="font-heading fw-bold fs-4 text-primary-fn">@we.Repetitions</div>
                                                <div class="text-white-50 small" style="font-size: 0.7rem;">REPETICIONES</div>
                                            </div>
                                            <div class="border-start border-secondary border-opacity-25"></div>
                                            <div>
                                                <div class="font-heading fw-bold fs-4 text-warning">@we.RestSeconds"</div>
                                                <div class="text-white-50 small" style="font-size: 0.7rem;">DESCANSO</div>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(we.Notes))
                                        {
                                            <div class="mt-2 pt-2 border-top border-secondary border-opacity-25 small text-info">
                                                <i class="fa-solid fa-circle-info me-1"></i><strong>Nota técnica:</strong> @we.Notes
                                            </div>
                                        }
                                    </div>

                                    <!-- Temporizador Interactivo de Descanso -->
                                    <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-50 text-center">
                                        <div class="font-heading small text-white-50 mb-1">TEMPORIZADOR DE DESCANSO</div>
                                        <div class="font-monospace fw-bold fs-2 text-warning mb-2" id="timerDisplay-@assignment.Id-@we.ExerciseId">
                                            @we.RestSeconds seg
                                        </div>
                                        <div class="d-flex gap-2 justify-content-center">
                                            <button type="button" class="btn btn-sm btn-outline-warning font-heading" 
                                                    onclick="startRestTimer('@assignment.Id-@we.ExerciseId', @we.RestSeconds)">
                                                <i class="fa-solid fa-stopwatch me-1"></i> Iniciar Descanso
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary text-white font-heading" 
                                                    onclick="resetRestTimer('@assignment.Id-@we.ExerciseId', @we.RestSeconds)">
                                                <i class="fa-solid fa-rotate-left"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Descripción Técnica del Movimiento -->
                                    @if (!string.IsNullOrEmpty(we.Exercise.Description))
                                    {
                                        <div class="mt-3 small text-muted">
                                            <strong class="text-white">Técnica:</strong> @we.Exercise.Description
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    }
}
else
{
    <!-- Si no tiene asignación activa de coach -->
    <div class="p-4 rounded-3 border border-fn bg-card-fn mb-5 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-surface-fn border border-fn p-3 text-primary-fn">
                <i class="fa-solid fa-dumbbell fa-xl"></i>
            </div>
            <div>
                <h5 class="font-heading text-white fw-bold mb-1">RUTINAS GENERALES DEL GIMNASIO</h5>
                <p class="text-muted small mb-0">
                    Tu suscripción activa te permite entrenar con todas las rutinas oficiales de FitNet a continuación.
                    @if (!Model.IsPremium)
                    {
                        <span>¿Querés un plan personalizado con entrenador personal? <a href="/Billing/Checkout?plan=premium" class="text-primary-fn fw-bold">Mejorar a Plan Premium</a>.</span>
                    }
                </p>
            </div>
        </div>
        @if (!Model.IsPremium)
        {
            <a href="/Billing/Checkout?plan=premium" class="btn btn-fn-primary btn-sm font-heading text-nowrap">
                <i class="fa-solid fa-crown me-1"></i> Pedir Entrenador Personal
            </a>
        }
    </div>
}

<!-- ==========================================
     SECCIÓN 2: BIBLIOTECA DE RUTINAS GENERALES
     ========================================== -->
<div class="mb-3">
    <div class="d-flex align-items-center gap-2 mb-1">
        <i class="fa-solid fa-layer-group text-primary-fn"></i>
        <h3 class="font-heading fs-4 fw-bold text-white mb-0">PLANES GENERALES DEL CLUB</h3>
    </div>
    <p class="text-muted small mb-4">Estructurados por los entrenadores de FitNet para cada objetivo físico.</p>
</div>

@if (Model.GeneralPlans.Any())
{
    <div class="row g-4">
        @foreach (var plan in Model.GeneralPlans)
        {
            <div class="col-lg-6">
                <div class="p-4 rounded-3 border border-fn bg-card-fn h-100 d-flex flex-column justify-content-between">
                    <div>
                        <!-- Badges -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-primary-fn text-uppercase font-heading">
                                Rutina General FitNet
                            </span>
                            <span class="text-muted small font-heading">
                                <i class="fa-solid fa-list-check me-1"></i> @plan.WorkoutExercises.Count Ejercicios
                            </span>
                        </div>

                        <!-- Título y Descripción -->
                        <h4 class="font-heading fs-5 fw-bold text-white mb-2">@plan.Name</h4>
                        <p class="text-muted small mb-3" style="line-height: 1.5;">
                            @(string.IsNullOrEmpty(plan.Description) ? "Plan estándar de acondicionamiento físico." : plan.Description)
                        </p>

                        <!-- Lista de ejercicios de la rutina -->
                        <div class="mb-3">
                            <span class="text-primary-fn font-heading small fw-bold text-uppercase d-block mb-2">
                                <i class="fa-solid fa-list-check me-1"></i> Secuencia del Entrenamiento:
                            </span>
                            <div class="d-flex flex-column gap-2">
                                @foreach (var we in plan.WorkoutExercises)
                                {
                                    <div class="workout-exercise-row d-flex justify-content-between align-items-center py-2 px-3 rounded-2 bg-surface-fn border border-secondary border-opacity-25">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-card-fn border border-fn text-primary-fn font-heading" style="width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">
                                                @we.Order
                                            </span>
                                            <div>
                                                <a asp-controller="Exercises" asp-action="Details" asp-route-id="@we.ExerciseId" class="text-white fw-bold text-decoration-none hover-primary small d-block">
                                                    @we.Exercise.Name
                                                </a>
                                                <span class="text-muted" style="font-size: 0.72rem;">
                                                    <i class="fa-solid fa-bullseye text-primary-fn me-1"></i>@we.Exercise.MuscleGroup · @we.Exercise.Difficulty
                                                </span>
                                            </div>
                                        </div>

                                        <div class="text-end font-heading">
                                            <div class="text-white fs-6 fw-bold">
                                                @we.Sets series <span class="text-primary-fn">×</span> @we.Repetitions reps
                                            </div>
                                            @if (we.RestSeconds > 0)
                                            {
                                                <small class="text-warning d-block" style="font-size: 0.72rem;">
                                                    <i class="fa-solid fa-stopwatch me-1"></i>@we.RestSeconds seg descanso
                                                </small>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Footer con coach que la diseñó -->
                    <div class="pt-3 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                        <span class="text-muted small">
                            <i class="fa-solid fa-user-tie me-1 text-primary-fn"></i>
                            @(plan.Trainer != null ? $"{plan.Trainer.FirstName} {plan.Trainer.LastName}" : "Equipo FitNet")
                        </span>

                        <a asp-controller="Exercises" asp-action="Index" class="btn btn-outline-light btn-sm font-heading">
                            Ver Ejercicios <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="p-4 rounded-3 border border-fn bg-card-fn text-center text-muted small">
        No hay rutinas generales cargadas en el sistema actualmente.
    </div>
}

<style>
    .workout-exercise-row {
        transition: border-color 0.2s ease, transform 0.15s ease;
    }
    .workout-exercise-row:hover {
        border-color: var(--fn-primary, #00f2fe) !important;
        transform: translateX(2px);
    }
    .hover-primary:hover {
        color: var(--fn-primary, #00f2fe) !important;
    }
</style>

@section Scripts {
    <script>
        function showRoutineTab(index) {
            document.querySelectorAll('.routine-card-container').forEach((el, idx) => {
                el.style.display = (idx === index) ? 'block' : 'none';
            });
            document.querySelectorAll('.routine-split-tab').forEach((btn, idx) => {
                if (idx === index) {
                    btn.className = 'btn btn-sm rounded-pill font-heading px-3 py-1 routine-split-tab btn-fn-primary text-dark fw-bold shadow-sm';
                } else {
                    btn.className = 'btn btn-sm rounded-pill font-heading px-3 py-1 routine-split-tab text-white-50 border-0';
                }
            });
        }

        const restIntervals = {};

        function startRestTimer(id, totalSeconds) {
            clearInterval(restIntervals[id]);
            let remaining = totalSeconds;
            const display = document.getElementById('timerDisplay-' + id);
            if (!display) return;

            display.textContent = remaining + ' seg';
            display.classList.remove('text-warning', 'text-success');
            display.classList.add('text-primary-fn');

            restIntervals[id] = setInterval(() => {
                remaining--;
                if (remaining <= 0) {
                    clearInterval(restIntervals[id]);
                    display.textContent = '¡A ENTRENAR! SERIE LISTA';
                    display.classList.remove('text-primary-fn');
                    display.classList.add('text-success');
                } else {
                    display.textContent = remaining + ' seg';
                }
            }, 1000);
        }

        function resetRestTimer(id, originalSeconds) {
            clearInterval(restIntervals[id]);
            const display = document.getElementById('timerDisplay-' + id);
            if (display) {
                display.textContent = originalSeconds + ' seg';
                display.classList.remove('text-primary-fn', 'text-success');
                display.classList.add('text-warning');
            }
        }
    </script>
}
