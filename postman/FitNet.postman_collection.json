{
	"info": {
		"_postman_id": "c1f7a0b3-96b4-4b47-a9a2-fitnetapi2026",
		"name": "FitNet API - ULP Laboratorio II",
		"description": "Colección oficial de endpoints REST para la API de FitNet.\nIncluye autenticación JWT Bearer y perfiles de usuario según el contrato canónico HTTP de la Fase 7.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "1. POST Login (Member - member@fitnet.com)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var data = pm.response.json();",
									"    pm.environment.set(\"jwt_token\", data.token);",
									"    pm.collectionVariables.set(\"jwt_token\", data.token);",
									"    console.log(\"Token JWT guardado exitosamente:\", data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"member@fitnet.com\",\n  \"password\": \"Member123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Autentica un socio y devuelve el token JWT con los datos del usuario. Al responder 200 OK, el script de tests guarda el token automáticamente en la variable `jwt_token`."
					},
					"response": []
				},
				{
					"name": "2. POST Login (Admin - admin@fitnet.com)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var data = pm.response.json();",
									"    pm.environment.set(\"jwt_token\", data.token);",
									"    pm.collectionVariables.set(\"jwt_token\", data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@fitnet.com\",\n  \"password\": \"Admin123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Autentica al administrador para obtener token con rol Admin."
					},
					"response": []
				},
				{
					"name": "3. POST Login (Credenciales Inválidas - 401)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"member@fitnet.com\",\n  \"password\": \"ClaveIncorrecta\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Prueba de seguridad: Debe responder con código HTTP 401 Unauthorized y mensaje descriptivo."
					},
					"response": []
				}
			]
		},
		{
			"name": "Perfil Protegido",
			"item": [
				{
					"name": "1. GET Mi Perfil (Bearer Token)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/profile",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"profile"
							]
						},
						"description": "Obtiene los datos del perfil y el estado de membresía consolidado a partir de los Claims del Bearer Token."
					},
					"response": []
				},
				{
					"name": "2. GET Mi Perfil (Sin Token - 401 Unauthorized)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/profile",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"profile"
							]
						},
						"description": "Prueba de seguridad: Comprueba que el middleware rechace con código HTTP 401 a peticiones sin el header Authorization Bearer."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5179",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	]
