			"name": "1. Autenticación (Auth API)",
			"item": [
				{
					"name": "1.1. POST Login (Member - member@fitnet.com)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var data = pm.response.json();",
									"    pm.environment.set(\"jwt_token\", data.token);",
									"    pm.collectionVariables.set(\"jwt_token\", data.token);",
									"    console.log(\"Token JWT Member guardado exitosamente:\", data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"member@fitnet.com\",\n  \"password\": \"Member123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Autentica un socio Gold y devuelve el token JWT con los datos del usuario. Al responder 200 OK, el test guarda el token en `jwt_token`."
					},
					"response": []
				},
